{
  "manifest_version": 3,
  "name": "Usama CRM Helper",
  "version": "1.1.0",
  "description": "Send listing details (Bayut, Dubizzle, Property Finder) and DXBinteract sales to Usama CRM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bayut.com/*",
    "https://dubai.dubizzle.com/*",
    "https://www.propertyfinder.ae/*",
    "https://usama-crm.vercel.app/*",
    "https://dxbinteract.com/*"
  ],
  "action": {
    "default_title": "Usama CRM Unit Finder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bayut.com/*",
        "https://dubai.dubizzle.com/*",
        "https://www.propertyfinder.ae/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dxbinteract.com/*"
      ],
      "js": [
        "dxb.js"
      ],
      "run_at": "document_idle"
    }
  ]
}