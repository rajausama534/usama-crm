{
  "manifest_version": 3,
  "name": "Usama CRM Helper",
  "version": "1.4.0",
  "description": "Read Bayut, Dubizzle and Property Finder listings for the Usama CRM Unit Finder, and send DXBinteract sales to the CRM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bayut.com/*",
    "https://dubai.dubizzle.com/*",
    "https://www.propertyfinder.ae/*",
    "https://usama-crm.vercel.app/*",
    "https://www.usamabinnusrat.com/*",
    "https://dxbinteract.com/*"
  ],
  "action": {
    "default_title": "Usama CRM Unit Finder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bayut.com/*",
        "https://dubai.dubizzle.com/*",
        "https://www.propertyfinder.ae/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dxbinteract.com/*"
      ],
      "js": [
        "dxb.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.usamabinnusrat.com/unit-finder*",
        "https://usama-crm.vercel.app/unit-finder*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}